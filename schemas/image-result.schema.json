{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runs-on-ami-example:image-result:1",
  "title": "Xenomai Cobalt AMI creation and qualification result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "source", "payload", "cloud", "execution", "validation", "lifecycle"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["candidate", "qualified", "failed"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe_id", "recipe_commit", "recipe_files", "input_lock_sha256", "parent_ami"],
      "properties": {
        "recipe_id": {"$ref": "#/$defs/sha256"},
        "recipe_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "recipe_files": {"$ref": "#/$defs/hash_map"},
        "input_lock_sha256": {"$ref": "#/$defs/sha256"},
        "parent_ami": {
          "type": "object",
          "required": ["id", "owner", "architecture", "boot_mode", "inventory_file", "inventory_sha256"],
          "properties": {
            "id": {"$ref": "#/$defs/ami"},
            "owner": {"type": "string", "pattern": "^[0-9]{12}$"},
            "architecture": {"const": "x86_64"},
            "boot_mode": {"enum": ["uefi", "uefi-preferred", "legacy-bios"]},
            "inventory_file": {"type": "string"},
            "inventory_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      }
    },
    "payload": {
      "type": "object",
      "required": ["schema_version", "recipe_id", "kernel_release", "config_sha256", "payload_hashes", "packages_sha256", "package_inventory", "snap_hashes", "normalized_configuration", "initramfs_sha256", "initramfs_content", "xenomai", "xenomai_files", "toolchain", "parent_inventory"],
      "properties": {
        "schema_version": {"const": 1},
        "recipe_id": {"$ref": "#/$defs/sha256"},
        "kernel_release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)*-xenomai-cobalt$"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "payload_hashes": {"$ref": "#/$defs/hash_map"},
        "packages_sha256": {"$ref": "#/$defs/sha256"},
        "package_inventory": {"type": "string"},
        "snap_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "normalized_configuration": {"$ref": "#/$defs/hash_map"},
        "initramfs_sha256": {"$ref": "#/$defs/sha256"},
        "initramfs_content": {"type": "object", "minProperties": 1},
        "xenomai": {"$ref": "#/$defs/cobalt"},
        "xenomai_files": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/installed_file"}},
        "toolchain": {"type": "object", "required": ["gcc", "ld"], "properties": {"gcc": {"type": "string"}, "ld": {"type": "string"}}, "additionalProperties": false},
        "parent_inventory": {"type": "object", "required": ["packages_sha256", "package_inventory", "runner_version", "runner_listener_sha256", "bootstrap_files", "registered", "workspaces", "secure_boot", "os_version"]}
      },
      "additionalProperties": false
    },
    "cloud": {
      "type": "object",
      "required": ["account_id", "region", "ami_id", "snapshot_ids", "architecture", "boot_mode", "ami_boot_mode", "instance_type"],
      "properties": {
        "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
        "region": {"type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"},
        "ami_id": {"$ref": "#/$defs/ami"},
        "snapshot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^snap-[0-9a-f]{17}$"}},
        "architecture": {"const": "x86_64"},
        "boot_mode": {"enum": ["uefi", "legacy-bios"]},
        "ami_boot_mode": {"enum": ["uefi", "uefi-preferred", "legacy-bios"]},
        "instance_type": {"type": "string"}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["build_id", "controller_instance_id", "runs_on_version", "tool_versions", "inherited_runner_version", "bootstrap_files"],
      "properties": {
        "build_id": {"type": "string", "pattern": "^[1-9][0-9]*-[1-9][0-9]*-(one|two)$"},
        "workflow_ref": {"type": "string"},
        "run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "run_attempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "controller_instance_id": {"$ref": "#/$defs/instance"},
        "runs_on_version": {"type": "string"},
        "tool_versions": {"type": "object", "required": ["packer", "amazon_plugin", "aws_cli", "session_manager"], "additionalProperties": {"type": "string"}},
        "inherited_runner_version": {"type": "string"},
        "bootstrap_files": {"$ref": "#/$defs/hash_map"}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["direct_boot", "runs_on", "reproducibility"],
      "properties": {
        "qualification": {"$ref": "#/$defs/qualification_run"},
        "direct_boot": {"$ref": "#/$defs/check"},
        "runs_on": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/check"}},
        "reproducibility": {"$ref": "#/$defs/check"},
        "errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["created_at", "expires_at", "retain", "artifact_locations", "cleanup"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "retain": {"type": "boolean"},
        "artifact_locations": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^s3://"}},
        "cleanup": {"$ref": "#/$defs/check"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "qualified"}}},
    "then": {"properties": {
      "validation": {"properties": {
        "direct_boot": {"required": ["instance_id", "terminated", "guest"], "properties": {"status": {"const": "passed"}, "terminated": {"const": true}, "guest": {"$ref": "#/$defs/cobalt_guest"}}},
        "runs_on": {"minItems": 2, "items": {"required": ["stage", "instance_id", "guest", "application"], "properties": {"status": {"const": "passed"}, "instance_id": {"$ref": "#/$defs/instance"}, "guest": {"$ref": "#/$defs/cobalt_guest"}, "application": {"const": {"name": "cobalt", "status": "passed"}}}}}
      }},
      "lifecycle": {"properties": {"cleanup": {"properties": {"status": {"const": "passed"}}}}}
    }}
  }],
  "$defs": {
    "qualification_run": {
      "type": "object", "required": ["build_id"], "additionalProperties": false,
      "properties": {
        "build_id": {"type": "string", "pattern": "^[1-9][0-9]*-[1-9][0-9]*-(one|two)$"},
        "run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "run_attempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "workflow_ref": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "cobalt_guest": {"type": "object", "required": ["xenomai"], "properties": {"xenomai": {"$ref": "#/$defs/cobalt"}}},
    "cobalt": {
      "type": "object", "required": ["version", "core", "prefix"], "additionalProperties": false,
      "properties": {"version": {"type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+$"}, "core": {"const": "cobalt"}, "prefix": {"const": "/usr/xenomai"}}
    },
    "installed_file": {
      "oneOf": [
        {"type": "object", "required": ["sha256", "mode"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "mode": {"type": "string", "pattern": "^0o[0-7]{3,4}$"}}, "additionalProperties": false},
        {"type": "object", "required": ["symlink"], "properties": {"symlink": {"type": "string", "minLength": 1}}, "additionalProperties": false}
      ]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ami": {"type": "string", "pattern": "^ami-[0-9a-f]{17}$"},
    "instance": {"type": "string", "pattern": "^i-[0-9a-f]{17}$"},
    "hash_map": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "check": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["pending", "passed", "failed"]}}}
  }
}
