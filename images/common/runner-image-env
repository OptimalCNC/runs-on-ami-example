#!/usr/bin/env python3
"""Expose image-owned values through GitHub's environment and path files."""
import json
import os
from pathlib import Path
import re
import sys

if sys.argv[1:] != ["--github"]:
    raise SystemExit("usage: runner-image-env --github")
manifest_path = Path("/etc/ami-example.json")
if manifest_path.stat().st_uid != 0 or manifest_path.stat().st_mode & 0o022:
    raise SystemExit("image manifest must be root-owned and not writable by group/others")
manifest = json.loads(manifest_path.read_text())
values = {"AMI_EXAMPLE_RECIPE_ID": manifest["recipe_id"], "AMI_EXAMPLE_KERNEL_RELEASE": manifest["kernel_release"],
          "XENOMAI_ROOT": manifest["xenomai"]["prefix"]}
if manifest["xenomai"]["core"] != "cobalt" or values["XENOMAI_ROOT"] != "/usr/xenomai":
    raise SystemExit("image must provide Xenomai Cobalt at /usr/xenomai")
if any(not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9/_.-]+", value) for value in values.values()):
    raise SystemExit("invalid image environment value")
with open(os.environ["GITHUB_ENV"], "a") as stream:
    for name, value in values.items():
        stream.write(f"{name}={value}\n")
with open(os.environ["GITHUB_PATH"], "a") as stream:
    stream.write(values["XENOMAI_ROOT"] + "/bin\n")
