#!/usr/bin/env python3
"""Print image-owned environment values for the caller to activate."""
import argparse
import json
from pathlib import Path
import re
import shlex

def environment(manifest_path):
    metadata = manifest_path.stat()
    if metadata.st_uid != 0 or metadata.st_mode & 0o022:
        raise ValueError("image manifest must be root-owned and not writable by group/others")
    manifest = json.loads(manifest_path.read_text())
    values = {"AMI_EXAMPLE_RECIPE_ID": manifest["recipe_id"], "AMI_EXAMPLE_KERNEL_RELEASE": manifest["kernel_release"],
              "XENOMAI_ROOT": manifest["xenomai"]["prefix"]}
    if manifest["xenomai"]["core"] != "cobalt" or values["XENOMAI_ROOT"] != "/usr/xenomai":
        raise ValueError("image must provide Xenomai Cobalt at /usr/xenomai")
    if any(not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9/_.-]+", value) for value in values.values()):
        raise ValueError("invalid image environment value")
    return {"env": values, "path": [values["XENOMAI_ROOT"] + "/bin"]}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", type=Path, default=Path("/etc/ami-example.json"))
    parser.add_argument("--format", choices=("json", "shell", "env"), default="json")
    args = parser.parse_args()
    result = environment(args.manifest)
    if args.format == "json":
        print(json.dumps(result, sort_keys=True))
    elif args.format == "env":
        for name, value in result["env"].items():
            print(f"{name}={value}")
    else:
        for name, value in result["env"].items():
            print(f"export {name}={shlex.quote(value)}")
        print(f'export PATH={shlex.quote(":".join(result["path"]))}:"$PATH"')


if __name__ == "__main__":
    main()
